{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zoom Wait Screen",
  "version": "1.0.0",
  "identifier": "com.zoomwaitscreen.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Zoom Wait Screen",
        "width": 480,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
