{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zoom Wait Screen",
  "version": "2.0.2",
  "identifier": "com.zoomwaitscreen.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zoom Wait Screen",
        "width": 480,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMjJGMTM0Rjg2MzRFMUIKUldRYlRtUDROUEVpN1NLWUxXTDAyNy9VYi8xQjR6MkY3dUhId0duem5KaHdLVjNWRTYxdjR4eFMK",
      "endpoints": ["https://github.com/Harnish/zoomwaitscreen/releases/latest/download/latest.json"]
    }
  }
}
